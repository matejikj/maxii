{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": "src/core",
    "outDir": ".test-dist/core"
  },
  "include": ["src/core/**/*.ts"],
  "exclude": ["node_modules", "**/*.tsx"]
}
