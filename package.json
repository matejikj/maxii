{
  "name": "maxii",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/lumi-forest",
    "packages/lumi-contracts",
    "apps/lumi-showcase",
    "apps/baby-tracker",
    "apps/lumi-api"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run baby:start",
    "baby:start": "npm run start --workspace @maxii/baby-tracker",
    "baby:android": "npm run android --workspace @maxii/baby-tracker",
    "baby:ios": "npm run ios --workspace @maxii/baby-tracker",
    "baby:web": "npm run web --workspace @maxii/baby-tracker",
    "baby:doctor": "npm run doctor --workspace @maxii/baby-tracker",
    "baby:bundle:android": "npm run export:android --workspace @maxii/baby-tracker",
    "baby:bundle:ios": "npm run export:ios --workspace @maxii/baby-tracker",
    "baby:bundle:web": "npm run export:web --workspace @maxii/baby-tracker",
    "showcase:start": "npm run start --workspace @lumi/showcase",
    "showcase:web": "npm run web --workspace @lumi/showcase",
    "storybook": "npm run storybook --workspace @lumi/showcase",
    "storybook:web": "npm run storybook:web --workspace @lumi/showcase",
    "expo:start": "npm run showcase:start",
    "expo:doctor": "npm run doctor --workspace @lumi/showcase",
    "expo:bundle:android": "npm run export:android --workspace @lumi/showcase",
    "expo:bundle:ios": "npm run export:ios --workspace @lumi/showcase",
    "expo:bundle:web": "npm run export:web --workspace @lumi/showcase",
    "expo:storybook": "npm run storybook",
    "expo:storybook:bundle:android": "npm run storybook:export:android --workspace @lumi/showcase",
    "expo:storybook:bundle:web": "npm run storybook:export:web --workspace @lumi/showcase",
    "build": "npm run build --workspace @lumi/forest-design",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:all": "npm run typecheck",
    "check:tsx": "node tools/check-ui-source.cjs",
    "check:boundaries": "node tools/check-import-boundaries.cjs",
    "check:secrets": "node tools/check-secrets.cjs",
    "check:lockfile": "node tools/check-lockfile.cjs",
    "sbom": "node tools/generate-sbom.cjs",
    "lint:baby": "npm run lint --workspace @maxii/baby-tracker",
    "test:contracts": "npm test --workspace @lumi/contracts",
    "test:api": "npm test --workspace @lumi/api",
    "test:apps": "node --test tests/*.test.cjs apps/lumi-showcase/tests/*.test.cjs && npm test --workspace @maxii/baby-tracker",
    "test": "npm test --workspace @lumi/forest-design && npm run test:contracts && npm run test:api && npm run test:apps",
    "family:compose:up": "docker compose -f apps/lumi-api/deploy/docker-compose.yml --profile attachments up -d postgres s3mock",
    "family:compose:down": "docker compose -f apps/lumi-api/deploy/docker-compose.yml --profile attachments down",
    "ops:compose-drill": "npm run ops:compose-drill --workspace @lumi/api",
    "test:all": "npm run test:all --workspace @lumi/forest-design && npm run test:apps && npm run check:tsx",
    "test:baby:pr": "npm run test:domain --workspace @maxii/baby-tracker && npm run test:storage --workspace @maxii/baby-tracker && npm run test:components --workspace @maxii/baby-tracker",
    "baby:test": "npm test --workspace @maxii/baby-tracker",
    "baby:prebuild": "npm run prebuild:native --workspace @maxii/baby-tracker"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-worklets": "0.13.0"
  }
}
