{
  "name": "@maxii/baby-tracker",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:web": "expo export --platform web --output-dir dist-web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test:domain && npm run test:storage && npm run test:components",
    "test:domain": "node --experimental-strip-types --import ./tests/ts-resolve-hook.mjs --test tests/domain/*.test.mts tests/config/*.test.mts tests/infrastructure/logger.test.mts",
    "test:storage": "node --experimental-strip-types --import ./tests/ts-resolve-hook.mjs --test tests/portable-backup.test.mts tests/stack-compatibility.test.mts tests/native-private-database.test.mts tests/web-private-database.test.mts tests/command-dispatcher.test.mts tests/personal-bootstrap.test.mts tests/today-diaper-flow.test.mts tests/sleep-session-flow.test.mts tests/feeding-flow.test.mts tests/growth-moments-flow.test.mts tests/history-flow.test.mts tests/care-overview-flow.test.mts tests/diary-backup-flow.test.mts tests/settings-privacy-flow.test.mts",
    "test:components": "node --experimental-strip-types --import ./tests/ts-resolve-hook.mjs --test tests/component/*.test.mts",
    "test:e2e": "playwright test",
    "test:e2e:native": "maestro test .maestro/smoke.yaml",
    "prebuild:native": "expo prebuild --clean",
    "run:android:cipher": "EXPO_PUBLIC_LUMI_STORAGE_PROBE=1 expo run:android",
    "run:ios:cipher": "EXPO_PUBLIC_LUMI_STORAGE_PROBE=1 expo run:ios",
    "doctor": "expo install --check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@lumi/forest-design": "1.0.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@tanstack/react-query": "^5.107.1",
    "dexie": "^4.4.7",
    "expo": "~58.0.23",
    "expo-crypto": "~58.0.7",
    "expo-secure-store": "^58.0.2",
    "expo-sqlite": "^58.0.15",
    "luxon": "^3.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/luxon": "^3.7.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
