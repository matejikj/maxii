# Public client configuration only. Never put service-role keys, signing
# material or recovery passwords in EXPO_PUBLIC_* variables.

# development | staging | production
EXPO_PUBLIC_LUMI_ENV=development

# Display name override for local shells
EXPO_PUBLIC_LUMI_APP_NAME=LUMI Baby Tracker

# Set to 1 only on development builds that must prove SQLCipher/SecureStore
EXPO_PUBLIC_LUMI_STORAGE_PROBE=0

# Reserved for the later family stage — leave unset for the personal offline app.
# EXPO_PUBLIC_LUMI_API_URL=
# EXPO_PUBLIC_LUMI_AUTH_ENABLED=0
# EXPO_PUBLIC_LUMI_SYNC_ENABLED=0
