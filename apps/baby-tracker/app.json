{
  "expo": {
    "name": "LUMI Baby Tracker",
    "slug": "lumi-baby-tracker",
    "scheme": "lumibaby",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.example.lumibabytracker",
      "supportsTablet": true,
      "infoPlist": {
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "com.example.lumibabytracker",
      "allowBackup": false
    }
  }
}
