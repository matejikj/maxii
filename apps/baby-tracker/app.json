{
  "expo": {
    "name": "LUMI Baby Tracker",
    "slug": "lumi-baby-tracker",
    "scheme": "lumibaby",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#3A5A40",
          "defaultChannel": "lumi-care-reminders"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ],
      "./plugins/withPersonalAndroidSigning.cjs"
    ],
    "ios": {
      "bundleIdentifier": "com.matejikj",
      "supportsTablet": true,
      "infoPlist": {
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "com.matejikj",
      "allowBackup": false
    }
  }
}
