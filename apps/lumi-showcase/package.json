{
  "name": "@lumi/showcase",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:web": "expo export --platform web --output-dir dist-web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "expo install --check",
    "storybook": "STORYBOOK_ENABLED=true expo start --clear",
    "storybook:android": "STORYBOOK_ENABLED=true expo start --android",
    "storybook:ios": "STORYBOOK_ENABLED=true expo start --ios",
    "storybook:web": "STORYBOOK_ENABLED=true expo start --web --clear",
    "storybook:export:web": "STORYBOOK_ENABLED=true STORYBOOK_SERVER=false expo export --platform web --output-dir dist-storybook-web",
    "storybook:export:android": "STORYBOOK_ENABLED=true STORYBOOK_SERVER=false expo export --platform android --output-dir dist-storybook-android",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write --ignore-unknown --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-unknown --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "check:quality": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@lumi/forest-design": "1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "storybook": "^10.4.0",
    "@storybook/react-native": "^10.4.0",
    "@storybook/react": "^10.4.0",
    "@storybook/addon-ondevice-controls": "^10.4.0",
    "@storybook/addon-ondevice-actions": "^10.4.0"
  }
}
