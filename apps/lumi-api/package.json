{
  "name": "@lumi/api",
  "version": "0.1.0",
  "private": true,
  "description": "Optional family API/BFF — personal tracker runs without this process",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && node --experimental-strip-types --test tests/*.test.mts",
    "ops:readiness": "bash ./deploy/ops-readiness.sh",
    "ops:compose-drill": "bash ./deploy/family-compose-stack-drill.sh",
    "ops:incident-rehearsal": "bash ./deploy/family-ops-incident-rehearsal.sh",
    "release:gate": "bash ./deploy/family-release-gate.sh",
    "security:matrix": "bash ./deploy/family-security-matrix.sh",
    "migration:drill": "bash ./deploy/managed-migration-local-drill.sh",
    "backup:new-device-drill": "bash ./deploy/remote-backup-new-device-drill.sh",
    "attachment:locator-drill": "bash ./deploy/attachment-locator-migration-drill.sh",
    "attachment:s3-drill": "bash ./deploy/attachment-s3-compatible-drill.sh",
    "attachment:http-s3-drill": "bash ./deploy/attachment-http-s3-drill.sh",
    "attachment:compose-drill": "bash ./deploy/attachment-compose-stack-drill.sh",
    "attachment:pg-meta-drill": "bash ./deploy/attachment-postgres-metadata-drill.sh",
    "attachment:http-pg-meta-drill": "bash ./deploy/attachment-http-postgres-metadata-drill.sh",
    "start": "node --experimental-strip-types ./src/main.ts",
    "start:worker": "LUMI_PROCESS_ROLE=worker node --experimental-strip-types ./src/main.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@lumi/contracts": "0.1.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "typescript": "~6.0.3"
  }
}
