{
  "name": "@lumi/api",
  "version": "0.1.0",
  "private": true,
  "description": "Optional family API/BFF — personal tracker runs without this process",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && node --experimental-strip-types --test tests/*.test.mts",
    "start": "node --experimental-strip-types ./src/main.ts",
    "start:worker": "LUMI_PROCESS_ROLE=worker node --experimental-strip-types ./src/main.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@lumi/contracts": "0.1.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "typescript": "~6.0.3"
  }
}
