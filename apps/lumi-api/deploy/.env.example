# Copy to a host-local .env outside Git when provisioning a VPS.
LUMI_PUBLIC_HOST=api.example.invalid
LUMI_API_HOST=127.0.0.1
LUMI_API_PORT=8787
LUMI_API_PUBLIC_URL=https://api.example.invalid
LUMI_APP_DB_PASSWORD=replace_me
LUMI_DATABASE_URL=postgres://lumi_app:replace_me@127.0.0.1:5432/lumi_app
LUMI_OIDC_ISSUER=https://auth.example.invalid/realms/lumi
LUMI_OIDC_AUDIENCE=lumi-api
LUMI_OIDC_JWKS_URL=https://auth.example.invalid/realms/lumi/protocol/openid-connect/certs
LUMI_OIDC_CLIENT_ID=lumi-api
LUMI_OIDC_CLIENT_SECRET=replace_me
LUMI_OIDC_TOKEN_URL=https://auth.example.invalid/realms/lumi/protocol/openid-connect/token
LUMI_OIDC_REDIRECT_URIS=com.matejikj://oidc/callback,https://app.example.invalid/oidc/callback
LUMI_CORS_ORIGINS=https://app.example.invalid
LUMI_RATE_LIMIT_PER_WINDOW=120
LUMI_RATE_LIMIT_WINDOW_MS=60000
LUMI_REQUEST_TIMEOUT_MS=15000
LUMI_WORKER_LEASE_MS=15000
LUMI_WORKER_POLL_MS=1000
# Ops bearer for /v1/ops/metrics and /v1/ops/alerts (leave unset to keep endpoints 401).
LUMI_OPS_BEARER_TOKEN=
# Set to 1 only after an uptime probe that does not run solely on this VPS is configured.
LUMI_OFF_HOST_PROBE_CONFIGURED=0
# Never set LUMI_OIDC_MOCK=1 or LUMI_TEST_HS256_SECRET outside automated tests.
# Future adapters (no secrets required to document): keycloak_self_hosted, postgres_self_hosted,
# future_supabase_otp, future_supabase_postgres, future_render.
#
# Optional private photo object store (Cloudflare R2 or local S3Mock). Leave unset
# for memory fallback — personal boots must not require a bucket.
# LUMI_ATTACHMENT_STORE=r2
# LUMI_R2_ENDPOINT=http://127.0.0.1:9090
# LUMI_R2_REGION=us-east-1
# LUMI_R2_BUCKET=lumi-family-photos
# LUMI_R2_ACCESS_KEY_ID=test
# LUMI_R2_SECRET_ACCESS_KEY=test
# Local drills (Compose Adobe S3Mock; not live Cloudflare R2):
#   npm run attachment:s3-drill
#   npm run attachment:http-s3-drill

