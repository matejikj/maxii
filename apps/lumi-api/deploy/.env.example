# Copy to a host-local .env outside Git when provisioning a VPS.
LUMI_API_HOST=127.0.0.1
LUMI_API_PORT=8787
LUMI_API_PUBLIC_URL=https://api.example.invalid
LUMI_DATABASE_URL=postgres://lumi_app:replace_me@127.0.0.1:5432/lumi_app
LUMI_OIDC_ISSUER=https://auth.example.invalid/realms/lumi
LUMI_OIDC_AUDIENCE=lumi-api
LUMI_OIDC_JWKS_URL=https://auth.example.invalid/realms/lumi/protocol/openid-connect/certs
LUMI_OIDC_CLIENT_ID=lumi-api
LUMI_OIDC_CLIENT_SECRET=replace_me
LUMI_OIDC_TOKEN_URL=https://auth.example.invalid/realms/lumi/protocol/openid-connect/token
LUMI_OIDC_REDIRECT_URIS=com.matejikj://oidc/callback,https://app.example.invalid/oidc/callback
LUMI_CORS_ORIGINS=https://app.example.invalid
# Never set LUMI_OIDC_MOCK=1 or LUMI_TEST_HS256_SECRET outside automated tests.
